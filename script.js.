let weatherOverlay = null;

// =======================================
// SHOW A NEW WEATHER SCREEN
// =======================================

function showWeatherScreen(content) {
    if (weatherOverlay) {
        weatherOverlay.remove();
    }

    weatherOverlay = document.createElement("div");
    weatherOverlay.className = "sky-overlay";

    weatherOverlay.innerHTML = `
        <div class="sky-container">
            <button class="sky-back" id="skyBack">
                ← Back to my sky
            </button>

            <div id="skyContent">
                ${content}
            </div>

            <p class="sky-note">
                DREAMY WEATHER · YOUR SKY, YOUR STORY
                <br>
                Weather data provided by Open-Meteo.
            </p>
        </div>
    `;

    document.body.appendChild(weatherOverlay);

    document.getElementById("skyBack").addEventListener("click", () => {
        weatherOverlay.remove();
        weatherOverlay = null;
    });

    weatherOverlay.scrollTop = 0;
}

// =======================================
// SEARCH FOR A CITY
// =======================================

async function searchWeather() {
    const city = searchInput.value.trim();

    if (!city) {
        searchInput.focus();
        alert("Please enter a city name first. ✨");
        return;
    }

    searchButton.disabled = true;
    searchButton.style.opacity = "0.6";

    showWeatherScreen(`
        <div class="sky-message sky-loading">
            <div style="font-size:55px">☁️</div>
            <h2>Finding your sky...</h2>
            <p>Looking for the weather in ${escapeHTML(city)}.</p>
        </div>
    `);

    try {
        // STEP 1: Find the city's geographical coordinates.

        const geoURL =
            "https://geocoding-api.open-meteo.com/v1/search" +
            "?name=" + encodeURIComponent(city) +
            "&count=10&language=en&format=json";

        const geoResponse = await fetch(geoURL);

        if (!geoResponse.ok) {
            throw new Error("Could not search for this city.");
        }

        const geoData = await geoResponse.json();

        if (!geoData.results || geoData.results.length === 0) {
            throw new Error(
                "We couldn't find that city. Please check its spelling."
            );
        }

        // Prefer a result whose name matches the entered city.

        const location =
            geoData.results.find(
                place => place.name.toLowerCase() === city.toLowerCase()
            ) || geoData.results[0];

        // STEP 2: Get the current weather for that location.

        const weatherURL =
            "https://api.open-meteo.com/v1/forecast" +
            "?latitude=" + location.latitude +
            "&longitude=" + location.longitude +
            "&current=temperature_2m,relative_humidity_2m," +
            "apparent_temperature,is_day,precipitation,weather_code,wind_speed_10m" +
            "&timezone=auto";

        const weatherResponse = await fetch(weatherURL);

        if (!weatherResponse.ok) {
            throw new Error("Weather data is temporarily unavailable.");
        }

        const weatherData = await weatherResponse.json();

        if (!weatherData.current) {
            throw new Error("No current weather data was returned.");
        }

        // STEP 3: Display the weather.

        displayWeather(location, weatherData);

    } catch (error) {
        console.error("Weather search error:", error);

        showWeatherScreen(`
            <div class="sky-message">
                <div style="font-size:55px">🌧️</div>
                <h2>We couldn't find your sky.</h2>
                <p>${escapeHTML(error.message)}</p>
                <p>Please check your internet connection and try again.</p>
            </div>
        `);

    } finally {
        searchButton.disabled = false;
        searchButton.style.opacity = "1";
    }
}

// =======================================
// DISPLAY THE WEATHER RESULTS
// =======================================

function displayWeather(location, data) {
    const current = data.current;

    const icon = getWeatherIcon(
        current.weather_code,
        current.is_day === 1
    );

    const condition = getWeatherDescription(current.weather_code);

    const temperature = Math.round(current.temperature_2m);

    const feelsLike = Math.round(current.apparent_temperature);

    const humidity = current.relative_humidity_2m;

    const windSpeed = current.wind_speed_10m;

    const cityName = location.name;

    const region = [location.admin1, location.country]
        .filter(Boolean)
        .filter((value, index, array) =>
            array.indexOf(value) === index
        )
        .join(", ");

    // The API provides the local time for the selected location.
    const localTime = current.time
        ? current.time.replace("T", " ")
        : "Unavailable";

    const timeZone = data.timezone || "Local time";

    showWeatherScreen(`
        <div class="sky-heading">
            <div class="sky-location">YOUR PERSONAL SKY DIARY</div>

            <h1>${escapeHTML(cityName)}</h1>

            <p>${escapeHTML(region)}</p>
        </div>

        <div class="sky-card">
            <div class="sky-icon">${icon}</div>

            <p class="sky-temperature">
                ${temperature}°
            </p>

            <p class="sky-condition">
                ${escapeHTML(condition)}
            </p>

            <p class="sky-time">
                🕰️ Local time: ${escapeHTML(localTime)}
                <br>
                ${escapeHTML(timeZone)}
            </p>

            <div class="sky-stats">
                <div class="sky-stat">
                    <div class="sky-stat-icon">🌡️</div>
                    <span class="sky-stat-label">Feels like</span>
                    <span class="sky-stat-value">${feelsLike}°C</span>
                </div>

                <div class="sky-stat">
                    <div class="sky-stat-icon">💧</div>
                    <span class="sky-stat-label">Humidity</span>
                    <span class="sky-stat-value">${humidity}%</span>
                </div>

                <div class="sky-stat">
                    <div class="sky-stat-icon">🍃</div>
                    <span class="sky-stat-label">Wind speed</span>
                    <span class="sky-stat-value">${windSpeed} km/h</span>
                </div>
            </div>
        </div>
    `);
}

// =======================================
// SAFELY DISPLAY USER-ENTERED TEXT
// =======================================

function escapeHTML(value) {
    return String(value).replace(/[&<>"']/g, character => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[character]);
}

// =======================================
// CONNECT THE SEARCH BUTTON
// =======================================

if (searchButton && searchInput) {
    searchButton.addEventListener("click", searchWeather);

    searchInput.addEventListener("keydown", event => {
        if (event.key === "Enter") {
            event.preventDefault();
            searchWeather();
        }
    });
}
