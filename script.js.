function formatDate(dateString) {
const date = new Date(dateString);

return new Intl.DateTimeFormat("en", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric"
}).format(date);

}

async function getWeather(city) {
const trimmedCity = city.trim();

if (!trimmedCity) {
    showStatus("Please enter a city name.", true);
    return;
}

searchButton.disabled = true;
searchButton.textContent = "Finding...";
showStatus("Looking for your city's sky... ✨");

try {
    const geoUrl =
        "https://geocoding-api.open-meteo.com/v1/search?name=" +
        encodeURIComponent(trimmedCity) +
        "&count=1&language=en&format=json";

    const geoResponse = await fetch(geoUrl);

    if (!geoResponse.ok) {
        throw new Error("Unable to search for this city right now.");
    }

    const geoData = await geoResponse.json();

    if (!geoData.results || geoData.results.length === 0) {
        throw new Error("City not found. Please check the spelling.");
    }

    const place = geoData.results[0];

    const weatherUrl =
        "https://api.open-meteo.com/v1/forecast" +
        "?latitude=" + place.latitude +
        "&longitude=" + place.longitude +
        "&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,weather_code,wind_speed_10m" +
        "&timezone=auto";

    const weatherResponse = await fetch(weatherUrl);

    if (!weatherResponse.ok) {
        throw new Error("Weather data is temporarily unavailable.");
    }

    const weatherData = await weatherResponse.json();
    const current = weatherData.current;

    if (!current) {
        throw new Error("No current weather data was returned.");
    }

    const details = getWeatherDetails(
        current.weather_code,
        current.is_day
    );

    const placeLabel = [place.name, place.admin1, place.country]
        .filter((value, index, array) =>
            value && array.indexOf(value) === index
        )
        .join(", ");

    cityName.textContent = placeLabel;
    localDate.textContent = formatDate(current.time);

    temperature.textContent =
        Math.round(current.temperature_2m);

    weatherDescription.textContent = details.description;

    feelsLike.textContent =
        "Feels like " +
        Math.round(current.apparent_temperature) +
        "°C";

    feelsLikeCard.textContent =
        Math.round(current.apparent_temperature) + "°C";

    humidity.textContent =
        current.relative_humidity_2m + "%";

    windSpeed.textContent =
        Number(current.wind_speed_10m).toFixed(1) + " km/h";

    conditionCard.textContent = details.description;
    weatherEmoji.textContent =
        current.is_day ? details.day : details.night;

    weatherSection.hidden = false;
    showStatus("Your sky has been found. ✨");

} catch (error) {
    showStatus(
        error.message ||
        "Something went wrong. Please try again.",
        true
    );
} finally {
    searchButton.disabled = false;
    searchButton.innerHTML = 'Find my sky <span>↗</span>';
}

}

weatherForm.addEventListener("submit", function (event) {
event.preventDefault();
getWeather(cityInput.value);
});

