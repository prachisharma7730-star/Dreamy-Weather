// ========================================
// DREAMY WEATHER
// City Search and Weather Display
// ========================================


// 1. CONNECT HTML ELEMENTS

const homeScreen = document.getElementById("home-screen");
const weatherScreen = document.getElementById("weather-screen");

const weatherForm = document.getElementById("weather-form");
const cityInput = document.getElementById("city-input");
const searchButton = document.getElementById("search-button");

const searchMessage = document.getElementById("search-message");

const backButton = document.getElementById("back-button");
const homeLink = document.getElementById("home-link");


// 2. API ADDRESSES

const GEOCODING_API =
    "https://geocoding-api.open-meteo.com/v1/search";

const WEATHER_API =
    "https://api.open-meteo.com/v1/forecast";


// 3. WEATHER DESCRIPTIONS AND ICONS

function getWeatherDetails(code, isDay) {

    if (code === 0) {
        return {
            description: "Clear sky",
            icon: isDay ? "☀️" : "🌙"
        };
    }

    if (code === 1) {
        return {
            description: "Mainly clear",
            icon: isDay ? "🌤️" : "🌙"
        };
    }

    if (code === 2) {
        return {
            description: "Partly cloudy",
            icon: isDay ? "⛅" : "☁️"
        };
    }

    if (code === 3) {
        return {
            description: "Overcast skies",
            icon: "☁️"
        };
    }

    if ([45, 48].includes(code)) {
        return {
            description: "Foggy weather",
            icon: "🌫️"
        };
    }

    if ([51, 53, 55, 56, 57].includes(code)) {
        return {
            description: "Light drizzle",
            icon: "🌦️"
        };
    }

    if ([61, 63, 65, 66, 67, 80, 81, 82].includes(code)) {
        return {
            description: "Rainy weather",
            icon: "🌧️"
        };
    }

    if ([71, 73, 75, 77, 85, 86].includes(code)) {
        return {
            description: "Snowy weather",
            icon: "❄️"
        };
    }

    if ([95, 96, 99].includes(code)) {
        return {
            description: "Thunderstorm",
            icon: "⛈️"
        };
    }

    return {
        description: "Changing skies",
        icon: "🌥️"
    };
}


// 4. SEARCH FOR A CITY AND GET ITS COORDINATES

async function findCity(city) {

    const url =
        `${GEOCODING_API}?name=${encodeURIComponent(city)}` +
        "&count=10&language=en&format=json";

    const response = await fetch(url);

    if (!response.ok) {
        throw new Error(
            "The city search service is unavailable. Please try again."
        );
    }

    const data = await response.json();

    if (!data.results || data.results.length === 0) {
        throw new Error(
            "City not found. Please check the spelling and try again."
        );
    }

    // Prefer an exact city-name match when available.

    const exactMatch = data.results.find(
        place => place.name.toLowerCase() === city.toLowerCase()
    );

    return exactMatch || data.results[0];
}


// 5. FETCH CURRENT WEATHER DATA

async function getWeather(latitude, longitude) {

    const url =
        `${WEATHER_API}?latitude=${latitude}` +
        `&longitude=${longitude}` +
        "&current=temperature_2m,relative_humidity_2m," +
        "apparent_temperature,is_day,precipitation," +
        "weather_code,wind_speed_10m,wind_direction_10m" +
        "&timezone=auto";

    const response = await fetch(url);

    if (!response.ok) {
        throw new Error(
            "The weather service is unavailable. Please try again."
        );
    }

    const data = await response.json();

    if (!data.current) {
        throw new Error(
            "Weather information is unavailable for this city."
        );
    }

    return data;
}


// 6. DISPLAY WEATHER DETAILS AND SWITCH INTERFACES

function displayWeather(place, weatherData) {

    const current = weatherData.current;

    const weather = getWeatherDetails(
        current.weather_code,
        current.is_day === 1
    );


    // Display city name and location.

    document.getElementById("result-city").textContent =
        place.name;

    document.getElementById("result-location").textContent =
        [place.admin1, place.country]
            .filter(Boolean)
            .join(", ");


    // Display weather description and icon.

    document.getElementById("weather-icon").textContent =
        weather.icon;

    document.getElementById("weather-description").textContent =
        weather.description;


    // Display temperature.

    document.getElementById("temperature-value").textContent =
        Math.round(current.temperature_2m);

    document.getElementById("feels-like").textContent =
        `Feels like ${Math.round(current.apparent_temperature)}°C`;


    // Display humidity.

    document.getElementById("humidity-value").textContent =
        current.relative_humidity_2m;


    // Display wind speed.

    document.getElementById("wind-value").textContent =
        current.wind_speed_10m;


    // Display wind direction.

    const windDirectionElement =
        document.getElementById("wind-direction");

    if (current.wind_direction_10m !== undefined) {

        windDirectionElement.textContent =
            `${current.wind_direction_10m}°`;

    } else {

        windDirectionElement.textContent =
            "Unavailable";

    }


    // Display precipitation.

    document.getElementById("precipitation-value").textContent =
        current.precipitation;


    // Display local observation time.

    document.getElementById("weather-local-time").textContent =
        `Local observation time: ${current.time.replace("T", " ")}`;


    // Display the weather data source.

    const weatherSource =
        document.getElementById("weather-source");

    if (weatherSource) {
        weatherSource.textContent =
            "Weather data provided by Open-Meteo.";
    }


    // SWITCH TO THE SECOND INTERFACE.

    homeScreen.hidden = true;
    weatherScreen.hidden = false;


    // Clear the previous search message.

    searchMessage.textContent = "";


    // Start the results page at the top.

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}


// 7. HANDLE THE CITY SEARCH FORM

weatherForm.addEventListener("submit", async function (event) {

    // Prevent the form from refreshing the page.

    event.preventDefault();

    const city = cityInput.value.trim();


    // Check whether the user entered a city.

    if (!city) {

        searchMessage.textContent =
            "Please enter a city name.";

        cityInput.focus();

        return;
    }


    // Prevent repeated clicks while loading.

    searchButton.disabled = true;

    searchButton.textContent =
        "Finding your sky...";

    searchMessage.textContent =
        "Searching the sky above you...";


    try {

        // First, find the city.

        const place = await findCity(city);


        // Second, fetch its current weather.

        const weatherData = await getWeather(
            place.latitude,
            place.longitude
        );


        // Third, display the results.

        displayWeather(place, weatherData);

    } catch (error) {

        console.error(
            "Dreamy Weather error:",
            error
        );

        searchMessage.textContent =
            error.message ||
            "Something went wrong. Please try again.";

    } finally {

        // Restore the search button.

        searchButton.disabled = false;

        searchButton.textContent =
            "Find My Sky ↗";
    }

});


// 8. CONNECT THE BACK BUTTON

backButton.addEventListener("click", function () {

    // Return to the home interface.

    weatherScreen.hidden = true;
    homeScreen.hidden = false;


    // Clear the previous search.

    cityInput.value = "";

    searchMessage.textContent = "";


    // Return to the top of the page.

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

    cityInput.focus();

});


// 9. CONNECT THE LOGO TO THE HOMEPAGE

homeLink.addEventListener("click", function (event) {

    event.preventDefault();

    weatherScreen.hidden = true;
    homeScreen.hidden = false;

    searchMessage.textContent = "";

});
